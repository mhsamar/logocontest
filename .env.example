# Copy to .env.local and fill in.

# Supabase → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server only. Never expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=

# Long random string used to hash OTP codes and verification tickets.
# Generate with: openssl rand -hex 32
OTP_SECRET=

# Long random string used to sign payment test-checkout links and callbacks.
APP_SECRET=

# Payment driver: "fake" opens a local test checkout page (development only).
PAYMENT_DRIVER=fake

# SMS driver: "log" prints messages to the server console (local development).
SMS_DRIVER=log

# Used by `npm run seed` to create the first admin account.
ADMIN_PHONE=
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_NAME=Admin
