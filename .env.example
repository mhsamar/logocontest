# Copy to .env.local and fill in.

# Supabase → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server only. Never expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=

# Long random string used to hash OTP codes and verification tickets.
# Generate with: openssl rand -hex 32
OTP_SECRET=

# Long random string used to sign payment test-checkout links and callbacks.
APP_SECRET=

# Payment driver: "fake" opens a local test checkout page (development only).
PAYMENT_DRIVER=fake

# Email driver: "log" prints emails (confirmation codes, reset links) to the server console.
EMAIL_DRIVER=log
# Absolute site URL: email links, canonical links, the sitemap and share previews (BLUEPRINT §15.1).
# Defaults to https://logocontest.bd for SEO and to the request's host for emails.
SITE_URL=
# Staging copies: set to true so search engines skip the whole site.
SEO_NOINDEX=
# Database backups (npm run backup:db): Supabase → Project Settings → Database → connection string (session pooler).
SUPABASE_DB_URL=

# Browser push (Web Push): "webpush" sends real notifications, "log" prints them.
# Make keys with: npx web-push generate-vapid-keys
PUSH_DRIVER=log
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:support@logocontest.bd

# SMS driver: "log" prints messages to the server console (local development).
SMS_DRIVER=log

# Used by `npm run seed` to create the first admin account.
ADMIN_PHONE=
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_NAME=Admin

# Image moderation for uploaded photos: "log" allows all (dev), "google" uses Cloud Vision SafeSearch.
MODERATION_DRIVER=log
GOOGLE_VISION_API_KEY=
# AI copyright checker (BLUEPRINT §7.7, owner 2026-10-10). A check needs the Claude key and at least one search key;
# without them the "Check with AI" button says the checker isn't set up and nothing is counted.
# Claude (reads the logo, compares shapes, writes the advice): https://console.anthropic.com
ANTHROPIC_API_KEY=
# Optional: the Claude model (default claude-sonnet-5-5).
LOGO_CHECK_MODEL=
# Real Google Lens results through SearchAPI.io (search_type=all, one search per check): https://www.searchapi.io
SEARCHAPI_API_KEY=
# Exact copies also use Google Cloud Vision Web Detection with GOOGLE_VISION_API_KEY above.
# Certificate (PDF + PNG) on a computer: the installed Google Chrome. Set this if Chrome is somewhere else.
CHROME_PATH=
# Withdrawals (BLUEPRINT §7.3): "fake" pays at once in development, "manual" sends everything to the admin queue,
# "bkash" sends bKash payouts automatically once the merchant payout credentials below are set.
PAYOUT_DRIVER=fake
BKASH_PAYOUT_BASE_URL=
BKASH_PAYOUT_APP_KEY=
BKASH_PAYOUT_APP_SECRET=
BKASH_PAYOUT_USERNAME=
BKASH_PAYOUT_PASSWORD=
# Lifecycle job (BLUEPRINT §6): a scheduler calls /api/cron/lifecycle every 15 minutes with
# "Authorization: Bearer <CRON_SECRET>". Use a long random value in production.
CRON_SECRET=
